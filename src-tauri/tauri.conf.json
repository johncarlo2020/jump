{
    "productName": "Air Mouse Runner",
    "version": "1.0.0",
    "identifier": "com.airmouserunner.game",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:5173",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Air Mouse Runner",
                "fullscreen": false,
                "resizable": true,
                "decorations": true,
                "width": 1280,
                "height": 720
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: https://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost; media-src 'self' asset: https://asset.localhost blob:"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}